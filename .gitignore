# Everything the pipeline writes lives under artifacts/ and is reproducible
# from `python main.py`. Keeping it out of version control is what stops the
# 57 per-trial VAE checkpoint directories (41 MB) from reappearing.
artifacts/

# Reviewed event labels: INPUT tables with entity ids and outcomes (sensitive, human-provided,
# never generated by the pipeline). Keep them out of version control.
data/reviewed_labels/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# NOTE: docs/documentation.html is generated (`python docs/build_docs.py`, never
# hand-edited) but IS versioned on purpose: it is the offline, navigable copy of
# all the documentation and must ship with the project. Regenerate it whenever a
# .md source changes and commit it with that change.

# Diagnostic-suite run outputs (CSVs/reports it writes when run against this
# project's data) -- reproducible from
# `python tools/export_diagnostic_suite_inputs.py`, same as artifacts/.
tools/if_vae_diagnostic_suite/build/

# OS noise
Thumbs.db
.DS_Store
